# =============================================================================
# Gestor de Tareas Operativas — variables de entorno
# Copiar a .env y reemplazar TODOS los valores marcados con "cambiar".
#   cp .env.example .env
# Las contraseñas no deben contener comillas simples (') ni el carácter $.
# Docker Compose lee este archivo automáticamente. Nunca versionar .env.
# =============================================================================

# --- Entorno -----------------------------------------------------------------
NODE_ENV=production
LOG_LEVEL=info

# --- SQL Server --------------------------------------------------------------
# La contraseña de SA debe cumplir la política de SQL Server:
# mínimo 8 caracteres, con mayúsculas, minúsculas, números y símbolos.
MSSQL_SA_PASSWORD=cambiar_Sa_Passw0rd!
MSSQL_PID=Developer
DB_HOST=db
DB_PORT=1433
DB_NAME=TaskManager
DB_ENCRYPT=true
DB_TRUST_SERVER_CERTIFICATE=true

# Usuario de aplicación con mínimo privilegio (solo EXECUTE sobre los SPs).
# El backend NUNCA usa SA. Lo crea el contenedor db-init.
DB_APP_USER=task_app
DB_APP_PASSWORD=cambiar_App_Passw0rd!

# --- API (backend) -----------------------------------------------------------
API_PORT=3000
# Secreto JWT: generar con  openssl rand -base64 48
JWT_SECRET=cambiar_por_un_secreto_largo_y_aleatorio_de_al_menos_32_caracteres
JWT_EXPIRES_IN=1h
BCRYPT_SALT_ROUNDS=12
# Protección contra fuerza bruta: intentos fallidos de login por IP antes de bloquear
AUTH_MAX_FAILED_ATTEMPTS=10
AUTH_LOCKOUT_MINUTES=15
# Captcha "No soy un robot" (prueba de trabajo propia, sin terceros) en login y recuperación
AUTH_CAPTCHA=true
# Orígenes permitidos por CORS (separados por coma). Si no se define: http://localhost:${FRONTEND_PORT}
# CORS_ORIGINS=http://localhost:8080
# Número de proxies delante de la API (nginx = 1). Necesario para el rate limit por IP.
TRUST_PROXY=1

# Usuario demo que se crea al iniciar si no existe (contraseña hasheada con bcrypt)
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=cambiar_Admin123!
SEED_ADMIN_FULL_NAME=Administrador Demo
# Correo del administrador (opcional): para que también pueda recuperar su contraseña por enlace
SEED_ADMIN_EMAIL=admin@fastco.test
# Datos de demostración de un BPO en operación (17 áreas, ~55 personas, ~4 meses de tareas con
# historial). Solo se cargan si la base no tiene tareas. Las cuentas demo quedan bloqueadas hasta
# que se define SEED_DEMO_PASSWORD (misma política: 10+ caracteres, mayúscula, minúscula y número).
SEED_DEMO_DATA=true
SEED_DEMO_PASSWORD=cambiar_Demo2026

# --- Correo ("¿Olvidaste tu contraseña?") -------------------------------------
# Por defecto se usa el servidor de pruebas Mailpit del compose (bandeja en http://localhost:8025).
# En producción: el SMTP corporativo (por ejemplo SMTP_HOST=smtp.office365.com, SMTP_PORT=587).
SMTP_HOST=mail
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Gestor de Tareas <no-responder@fastco.test>
# URL pública de la app (con ella se arma el enlace del correo). Si no se define, se usa
# http://localhost:${FRONTEND_PORT}. En producción, la URL real (por ejemplo https://tareas.empresa.com).
# APP_PUBLIC_URL=
MAIL_UI_PORT=8025

# --- Frontend ----------------------------------------------------------------
FRONTEND_PORT=8080
